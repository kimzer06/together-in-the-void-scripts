# ============================================================
# Unity standard ignores
# ============================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should be tracked, but the generated Library/Temp/etc above should not
[Rr]ecordings/

# Autogenerated VS/Rider/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Editor RSpec
/[Aa]ssets/[Tt]ests/[Ee]ditor/*

# ============================================================
# Third-party / Asset Store packages — DO NOT COMMIT
# Their license does not permit redistributing the asset's own
# files publicly. Only your own original scripts should be
# pushed to a public repo. Add every purchased/downloaded
# package folder here (check Assets/<PackageName>/ and
# Assets/Plugins/<PackageName>/).
# ============================================================
[Aa]ssets/Pungins/
[Aa]ssets/Plugins/MagicaCloth2/
[Aa]ssets/Plugins/Sirenix/
[Aa]ssets/Plugins/Feel/
[Aa]ssets/Plugins/MoreMountains/
[Aa]ssets/DOTween/
[Aa]ssets/FishNet/
[Aa]ssets/Archanor/
[Aa]ssets/AutoTranslate/
[Aa]ssets/ParadoxNotion/
[Aa]ssets/QuickOutline/
[Aa]ssets/StarterAssets/
[Aa]ssets/TextMesh Pro/
[Aa]ssets/Fantasy Skybox FREE/
[Aa]ssets/Real Stars Skybox/
# TIP: run `find Assets -maxdepth 2 -iname "*.asmdef"` or check the
# Asset Store window's "My Assets" list to make sure every purchased
# package folder above is actually excluded before your first commit.
